<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> drops any source inherited from a machine-level or user-level
       nuget.config, so restore resolves against exactly one known feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Package source mapping. With a single source this is a guard rather than a
       router: adding a second feed later cannot silently serve an existing
       package name from the new source. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
