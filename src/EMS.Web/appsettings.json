{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EMS;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "TimeZoneOffsetHours": 4,
    "WorkDayStartHour": 8,
    "WorkDayEndHour": 16,
    "SessionTimeoutMinutes": 30,
    "SecurityStampRevalidationMinutes": 30,
    "NotificationRetentionDays": 30,
    "ProbationMonths": 3,
    "MaxPageSize": 100,
    "DefaultLeaveEntitlements": {
      "Annual": 21,
      "Sick": 10,
      "Maternity": 90,
      "Compassionate": 5
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutDurationMinutes": 15
    },
    "RateLimit": {
      "LoginAttemptsPerMinute": 10
    },
    "SeedData": {
      "Enabled": false,
      "EmployeeCount": 15,
      "AttendanceHistoryDays": 30,
      "RandomizerSeed": 20260812
    }
  }
}
